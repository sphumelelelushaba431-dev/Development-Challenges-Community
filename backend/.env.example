# Copy this file to backend/.env and fill it in. backend/.env is git-ignored — never commit real passwords.

# Where members open the site (used for the login link in e-mails)
APP_URL=http://localhost:3000

# SMTP — Gmail example. Create an App Password: Google Account → Security → 2-Step Verification → App passwords.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME=Development Challenges Community

# true = new accounts wait for the administrator's approval before they can log in
REQUIRE_APPROVAL=true
